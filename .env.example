# FintNet environment configuration — copy to .env and fill in your own values.
# Anything you don't set falls back to the localhost / sandbox defaults baked into the code.

# ── App ──────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///ais.db
USE_AI_CATEGORIZER=true                           # toggle the LLM categorizer (false = rules only)
SESSION_IDLE_MINUTES=15                           # idle sign-out; 5 follows the SCA-RTS figure for a bank's own session


# ── UniCredit (mTLS + Berlin Group consent, /hydrogen/v1 API) ────────────────
SANDBOX_BASE_URL=https://api-sandbox.unicredit.it
REDIRECT_URI=https://localhost:5000/callback      # must be https (sandbox accepts localhost)
UC_X_COUNTRY=IT                                   # "IT" = Italy
UC_X_LEGAL_ENTITY=UI                              # "UI" = UniCredit Italia; other entities use different codes
CERT_PATH=certs/eIDAS_test.crt                    # generated by generate_psd2_cert.py
KEY_PATH=certs/eIDAS_test.key


# ── Commerzbank ──────────────────────────────────────────────────────────────
# Register at https://developer.commerzbank.com to get sandbox credentials.
CB_CLIENT_ID=
CB_CLIENT_SECRET=
CB_REDIRECT_URI=http://localhost:5000/commerzbank/callback


# ── Nordea ───────────────────────────────────────────────────────────────────
# Register at https://developer.nordeaopenbanking.com.
NORDEA_CLIENT_ID=
NORDEA_CLIENT_SECRET=
NORDEA_COUNTRY=FI                                 # FI / SE / NO / DK
NORDEA_REDIRECT_URI=http://localhost:5000/nordea/callback


# ── ING (mTLS + HTTP Signatures + OAuth2) ────────────────────────────────────
# Register at https://developer.ing.com.
ING_CLIENT_ID=
ING_COUNTRY_CODE=NL
ING_TLS_CERT_PATH=certs/ing_tls.cer
ING_TLS_KEY_PATH=certs/ing_tls.key
ING_SIGNING_CERT_PATH=certs/ing_signing.cer
ING_SIGNING_KEY_PATH=certs/ing_signing.key
ING_REDIRECT_URI=http://localhost:5000/ing/callback


# ── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_MAX_CALLS=400                                 # per-instance cap on model calls
CATEGORIZER_PROVIDER=                             # anthropic / ollama / rules; empty picks by key


# ── Tracing and evaluations (optional) ───────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
GROQ_API_KEY=                                     # assistant evaluation judge


# ── Hosted only ──────────────────────────────────────────────────────────────
CRON_SECRET=                                      # bearer token for /cron/*
OPS_HOST=                                         # hostname that serves only the operations view
EVENT_LOG_BACKEND=                                # db / redis / file; empty picks by environment
