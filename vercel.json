{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["templates/**", "synthbank/**", "evals/results/assistant_*.json"] }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "crons": [
    { "path": "/cron/feed", "schedule": "0 1 * * *" },
    { "path": "/cron/categorise", "schedule": "0 2 * * *" },
    { "path": "/cron/evaluate", "schedule": "0 3 * * *" },
    { "path": "/cron/health", "schedule": "0 4 * * *" }
  ]
}
